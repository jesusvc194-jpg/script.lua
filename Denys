-- ==================== UUID FILTER ====================

local function isUUID(str)
    return str:match("%x%x%x%x%x%x%x%x%-%x%x%x%x")
end

-- ==================== DETECCIÓN ====================

local function checkForSecret()

    for _, obj in pairs(Workspace:GetDescendants()) do

        -- SOLO MODELOS
        if obj:IsA("Model") then

            local name = obj.Name:lower()

            -- Ignora UUIDs
            if isUUID(name) then
                continue
            end

            -- Ignora jugadores
            if Players:FindFirstChild(obj.Name) then
                continue
            end

            -- Ignora modelos vacíos
            if #obj:GetDescendants() < 3 then
                continue
            end

            -- Buscar keywords
            for _, word in ipairs(keywords) do

                if name:find(word) then

                    found = true

                    notify(
                        "🎉 ¡SECRET ENCONTRADO!",
                        "Brainrot: " .. obj.Name
                    )

                    print("✅ BRAINROT DETECTADO:", obj.Name)

                    return true
                end
            end
        end

        -- DETECCIÓN DE TEXTOS GUI
        if obj:IsA("TextLabel") then

            local txt = obj.Text:lower()

            for _, word in ipairs(keywords) do

                if txt:find(word) then

                    found = true

                    notify(
                        "🎉 SECRET DETECTADO!",
                        obj.Text
                    )

                    print("✅ TEXTO DETECTADO:", obj.Text)

                    return true
                end
            end
        end
    end

    return false
end

-- ==================== INFO SERVIDOR ====================

local function getServerInfo()

    local serverId = game.JobId or "Desconocido"
    local players = #Players:GetPlayers()

    return "Servidor: "
        .. serverId:sub(1,8)
        .. "... | Jugadores: "
        .. players
end

-- ==================== SERVER HOP ====================

local function hopLowPlayerServer()

    if not running or found then
        return
    end

    notify(
        "🔍 Buscando",
        "Servidor con máximo 4 jugadores"
    )

    local success, result = pcall(function()

        return game:HttpGet(
            "https://games.roblox.com/v1/games/"
            .. PLACE_ID
            .. "/servers/Public?sortOrder=Asc&limit=100"
        )
    end)

    if not success then

        notify(
            "❌ Error",
            "No se pudo obtener servidores"
        )

        return
    end

    local data = HttpService:JSONDecode(result)

    for _, server in pairs(data.data) do

        local id = server.id
        local playing = server.playing

        if not visitedServers[id]
        and id ~= game.JobId
        and playing <= 4 then

            visitedServers[id] = true

            notify(
                "🚀 Entrando",
                "Servidor con " .. playing .. " jugadores"
            )

            wait(2)

            TeleportService:TeleportToPlaceInstance(
                PLACE_ID,
                id,
                LocalPlayer
            )

            return
        end
    end

    notify(
        "⚠️ No Encontrado",
        "No hay servidores nuevos"
    )
end

