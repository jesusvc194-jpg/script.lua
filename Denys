-- ==================== DETECCIÓN ====================

local function checkForSecret()
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("Part") or obj:IsA("MeshPart") then
            local name = obj.Name:lower()

            for _, word in ipairs(keywords) do
                if name:find(word) then
                    found = true

                    notify(
                        "🎉 ¡SECRET ENCONTRADO!",
                        "Nombre: " .. obj.Name
                    )

                    print("✅ ENCONTRADO: " .. obj.Name)

                    return true
                end
            end
        end
    end

    return false
end

-- ==================== INFO ====================

local function getServerInfo()
    local serverId = game.JobId or "Desconocido"
    local players = #Players:GetPlayers()

    return "Servidor: "
        .. serverId:sub(1,8)
        .. "... | Jugadores: "
        .. players
end

-- ==================== SERVER HOP NORMAL ====================

local function hopServer()
    if not running or found then
        return
    end

    notify("🔄 Cambiando Servidor", getServerInfo())

    wait(2)

    TeleportService:Teleport(PLACE_ID, LocalPlayer)
end

-- ==================== SERVER HOP INTELIGENTE ====================

local function hopLowPlayerServer()
    if not running or found then
        return
    end

    notify("🔍 Buscando", "Servidor con máximo 4 jugadores")

    local success, result = pcall(function()
        return game:HttpGet(
            "https://games.roblox.com/v1/games/"
            .. PLACE_ID
            .. "/servers/Public?sortOrder=Asc&limit=100"
        )
    end)

    if not success then
        notify("❌ Error", "No se pudo obtener servidores")
        return
    end

    local data = HttpService:JSONDecode(result)

    for _, server in pairs(data.data) do

        local id = server.id
        local playing = server.playing

        -- Evita servidores repetidos
        if not visitedServers[id]
        and id ~= game.JobId
        and playing <= 4 then

            visitedServers[id] = true

            notify(
                "🚀 Entrando",
                "Servidor con " .. playing .. " jugadores"
            )

            wait(2)

            TeleportService:TeleportToPlaceInstance(
                PLACE_ID,
                id,
                LocalPlayer
            )

            return
        end
    end

    notify("⚠️ No Encontrado", "No hay servidores pequeños nuevos")
end

