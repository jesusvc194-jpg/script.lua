--// DRAG SYSTEM
local dragging
local dragInput
local dragStart
local startPos

local function update(input)

    local delta = input.Position - dragStart

    frame.Position = UDim2.new(
        startPos.X.Scale,
        startPos.X.Offset + delta.X,
        startPos.Y.Scale,
        startPos.Y.Offset + delta.Y
    )
end

title.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1 then

        dragging = true
        dragStart = input.Position
        startPos = frame.Position

        input.Changed:Connect(function()

            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

title.InputChanged:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseMovement then
        dragInput = input
    end
end)

UIS.InputChanged:Connect(function(input)

    if input == dragInput and dragging then
        update(input)
    end
end)

--// MONEY CONVERTER
local function convert(text)

    local num, letter =
        string.match(text,"%$(%d+%.?%d*)([KMB])/s")

    if not num then
        return nil
    end

    num = tonumber(num)

    if letter == "K" then
        num = num * 1e3
    elseif letter == "M" then
        num = num * 1e6
    elseif letter == "B" then
        num = num * 1e9
    end

    return num
end

--// ESP
local function createESP(model)

    if model:FindFirstChild("FinderESP") then
        return
    end

    local h = Instance.new("Highlight")
    h.Name = "FinderESP"
    h.FillColor = Color3.fromRGB(255,0,0)
    h.OutlineColor = Color3.fromRGB(255,255,255)
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = model
end

--// SERVER HOP
local function ServerHop()

    if not AutoHop then
        return
    end

    info.Text = "Buscando nuevo servidor..."

    local success, result = pcall(function()

        return game:HttpGet(
            "https://games.roblox.com/v1/games/"..
            PlaceId..
            "/servers/Public?sortOrder=Asc&limit=100"
        )
    end)

    if not success then
        return
    end

    local data = HttpService:JSONDecode(result)

    for _,server in pairs(data.data) do

        if server.playing < server.maxPlayers
        and not getgenv().VisitedServers[server.id] then

            getgenv().VisitedServers[server.id] = true

            info.Text =
                "Entrando a nuevo servidor..."

            task.wait(2)

            TeleportService:TeleportToPlaceInstance(
                PlaceId,
                server.id,
                LP
            )

            break
        end
    end
end

--// MAIN SCAN
task.spawn(function()

    while task.wait(SCAN_DELAY) do

        local bestValue = 0
        local bestText = ""
        local bestModel = nil

        for _,v in pairs(workspace:GetDescendants()) do

            if v:IsA("TextLabel") then

                local txt = v.Text
                local value = convert(txt)

                if value and value >= MIN_VALUE then

                    if value > bestValue then

                        bestValue = value
                        bestText = txt

                        local model =
                            v:FindFirstAncestorOfClass("Model")

                        if model then
                            bestModel = model
                        end
                    end
                end
            end
        end

        --// TARGET FOUND
        if bestValue > 0 and bestModel then

            targetFound = true
            currentTarget = bestModel

            createESP(bestModel)

            targetPart =
                bestModel.PrimaryPart
                or bestModel:FindFirstChildWhichIsA("BasePart")

            info.Text =
                "ENCONTRADO!\n\n"..
                "DINERO : "..bestText.."\n"..
                "MODELO : "..bestModel.Name.."\n\n"..
                "Esperando..."

        else

            --// TARGET LOST
            if targetFound then

                targetFound = false
                currentTarget = nil
                targetPart = nil

                info.Text =
                    "TARGET PERDIDO\n\n"..
                    "Rebuscando en "..LOST_WAIT.." segundos..."

                task.wait(LOST_WAIT)
            end

            --// STILL NOTHING
            local foundAgain = false

            for _,v in pairs(workspace:GetDescendants()) do

                if v:IsA("TextLabel") then

                    local value = convert(v.Text)

                    if value and value >= MIN_VALUE then
                        foundAgain = true
                        break
                    end
                end
            end

            if not foundAgain then

                info.Text =
                    "Nada encontrado arriba de 30M/s\n\n"..
                    "Cambiando servidor..."

                ServerHop()
            end
        end
    end
end)
