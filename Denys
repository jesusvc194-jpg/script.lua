-- === SERVER HOPPER AVANZADO + DETECCIÓN DE SERVIDOR ACTUAL ===
local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer

local PLACE_ID = game.PlaceId
local running = true
local found = false

print("🔍 Server Hopper con detección de servidor activado")

local function notify(title, text)
    game.StarterGui:SetCore("SendNotification", {Title = title, Text = text, Duration = 8})
end

-- Lista de detección (con errores comunes)
local keywords = {
    "secret", "secreto", "67", "bunitos", "bonitos", "spyderrinis", "tralalero", 
    "fragola", "cucaracha", "tralaleritos", "tortus", "guerriro", "examine", 
    "matteo", "karkerkar", "sahur", "vaquitas", "perrito", "hotspot", "jobcitos",
    "combinasion", "mariachi", "nuclearo", "tacorita", "hotspotsitos", "puggy",
    "celularcini", "bros", "tralaledon", "primos", "tictac", "ketchuru", "garama",
    "spaghetti", "dragon", "burguro", "chillin", "strawberry", "developini"
}

local function checkForSecret()
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("Part") or obj:IsA("MeshPart") then
            local name = obj.Name:lower()
            for _, word in ipairs(keywords) do
                if name:find(word) then
                    found = true
                    notify("🎉 ¡SECRET ENCONTRADO!", "Nombre: " .. obj.Name)
                    print("✅ ENCONTRADO: " .. obj.Name)
                    return true
                end
            end
        end
    end
    return false
end

local function getServerInfo()
    local serverId = game.JobId or "Desconocido"
    local players = #Players:GetPlayers()
    return "Servidor: " .. serverId:sub(1,8) .. "... | Jugadores: " .. players
end

local function hopServer()
    if not running or found then return end
    notify("🔄 Cambiando Servidor", getServerInfo())
    wait(2)
    TeleportService:Teleport(PLACE_ID, LocalPlayer)
end

-- Loop principal
spawn(function()
    while running and not found do
        wait(4)
        if checkForSecret() then break end
        hopServer()
        wait(9)
    end
end)

-- ==================== GUI ====================
local sg = Instance.new("ScreenGui")
sg.Name = "SecretHopper"
sg.ResetOnSpawn = false
sg.Parent = LocalPlayer.PlayerGui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 280, 0, 220)
frame.Position = UDim2.new(1, -300, 0, 60)
frame.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
frame.Parent = sg

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1,0,0,40)
title.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
title.Text = "🔍 SECRET HOPPER"
title.TextColor3 = Color3.new(1,1,1)
title.TextScaled = true
title.Parent = frame

local serverInfo = Instance.new("TextLabel")
serverInfo.Size = UDim2.new(1,0,0,30)
serverInfo.Position = UDim2.new(0,0,0,40)
serverInfo.BackgroundTransparency = 1
serverInfo.TextColor3 = Color3.fromRGB(100, 200, 255)
serverInfo.TextScaled = true
serverInfo.Parent = frame

spawn(function()
    while running do
        serverInfo.Text = getServerInfo()
        wait(3)
    end
end)

-- Botones
local stopBtn = Instance.new("TextButton")
stopBtn.Size = UDim2.new(0.9,0,0,40)
stopBtn.Position = UDim2.new(0.05,0,0,80)
stopBtn.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
stopBtn.Text = "⛔ Detener Hopper"
stopBtn.TextColor3 = Color3.new(1,1,1)
stopBtn.TextScaled = true
stopBtn.Parent = frame

local minimizeBtn = Instance.new("TextButton")
minimizeBtn.Size = UDim2.new(0.9,0,0,40)
minimizeBtn.Position = UDim2.new(0.05,0,0,130)
minimizeBtn.BackgroundColor3 = Color3.fromRGB(255, 140, 0)
minimizeBtn.Text = "⏬ Minimizar"
minimizeBtn.TextColor3 = Color3.new(1,1,1)
minimizeBtn.TextScaled = true
minimizeBtn.Parent = frame

stopBtn.MouseButton1Click:Connect(function()
    running = false
    notify("⛔ Detenido", "El hopper se ha detenido")
end)

minimizeBtn.MouseButton1Click:Connect(function()
    frame.Visible = not frame.Visible
    minimizeBtn.Text = frame.Visible and "⏬ Minimizar" or "🔼 Mostrar"
end)

notify("🚀 Hopper Activado", "Buscando Secret + Bunitos y más")
notify("Servidor Actual", getServerInfo())
