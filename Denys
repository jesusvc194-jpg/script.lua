--// CLEAN TEXT

local function CleanText(text)

	text = text:lower()
	text = text:gsub("%s+"," ")
	text = text:gsub("[^%w%s]","")

	return text
end

--// DETECTOR

local function IsValidBrainrot(model)

	if not model:IsA("Model") then
		return false
	end

	if not model:FindFirstChild("Humanoid")
	and not model:FindFirstChild("HumanoidRootPart")
	and not model.PrimaryPart then
		return false
	end

	local foundName = nil
	local foundRare = false

	for _,v in ipairs(model:GetDescendants()) do

		if v:IsA("TextLabel") then

			local text = CleanText(v.Text)

			for name,_ in pairs(ValidNames) do

				if string.find(text,name) then
					foundName = name
				end
			end

			for rare,_ in pairs(ValidRarities) do

				if string.find(text,rare) then
					foundRare = true
				end
			end
		end
	end

	if foundName and foundRare then
		return true, foundName
	end

	return false
end

--// SERVER HOP

local hopping = false

function ServerHop()

	if hopping then
		return
	end

	hopping = true

	local success,err = pcall(function()

		log.Text = "[HOP]\nSearching New Server..."

		local req =
			game:HttpGet(
				"https://games.roblox.com/v1/games/" ..
				PlaceID ..
				"/servers/Public?sortOrder=Asc&limit=100"
			)

		local data = HttpService:JSONDecode(req)

		for _,server in ipairs(data.data) do

			if server.id ~= JobID
			and server.playing < server.maxPlayers
			and not visited[server.id] then

				visited[server.id] = true

				writefile(
					FILE,
					HttpService:JSONEncode(visited)
				)

				task.wait(1)

				TeleportService:TeleportToPlaceInstance(
					PlaceID,
					server.id,
					LocalPlayer
				)

				return
			end
		end
	end)

	if not success then

		log.Text =
			"[ERROR]\n"..tostring(err)
	end

	hopping = false
end

hopBtn.MouseButton1Click:Connect(function()
	ServerHop()
end)

