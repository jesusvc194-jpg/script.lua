local function getServerInfo()

    local serverId = game.JobId or "Desconocido"
    local players = #Players:GetPlayers()

    return "Servidor: "
        .. serverId:sub(1,8)
        .. "... | Jugadores: "
        .. players
end

-- ==================== SERVER HOP ====================

local function hopServer()

    if not running or found then
        return
    end

    notify(
        "🔄 Cambiando",
        "Buscando servidor nuevo"
    )

    visitedServers[game.JobId] = true

    local success, result = pcall(function()

        return game:HttpGet(
            "https://games.roblox.com/v1/games/"
            .. PLACE_ID ..
            "/servers/Public?sortOrder=Asc&limit=100"
        )
    end)

    if not success then

        notify(
            "❌ Error",
            "No se pudieron obtener servidores"
        )

        return
    end

    local data = HttpService:JSONDecode(result)

    for _, server in pairs(data.data) do

        local id = server.id
        local playing = server.playing
        local maxPlayers = server.maxPlayers

        if id ~= game.JobId
        and not visitedServers[id]
        and playing < maxPlayers then

            visitedServers[id] = true

            notify(
                "🚀 Entrando",
                "Jugadores: " .. playing
            )

            wait(1)

            TeleportService:TeleportToPlaceInstance(
                PLACE_ID,
                id,
                LocalPlayer
            )

            return
        end
    end

    -- FALLBACK
    notify(
        "⚠️ Reintentando",
        "Usando teleport normal"
    )

    wait(1)

    TeleportService:Teleport(
        PLACE_ID,
        LocalPlayer
    )
end

