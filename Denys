-- ==================== UUID FILTER ====================

local function isUUID(str)

    return str:match("%x%x%x%x%x%x%x%x%-%x%x%x%x")
end

-- ==================== DETECCIÓN ====================

local function checkForSecret()

    for _, obj in pairs(Workspace:GetDescendants()) do

        if obj:IsA("Model") then

            local name = obj.Name:lower()

            -- Ignora UUID
            if isUUID(name) then
                continue
            end

            -- Ignora jugadores
            if Players:FindFirstChild(obj.Name) then
                continue
            end

            -- Debe tener partes físicas
            local valid = false

            for _, v in pairs(obj:GetDescendants()) do

                if v:IsA("MeshPart")
                or v:IsA("Part") then

                    valid = true
                    break
                end
            end

            if not valid then
                continue
            end

            -- Buscar keywords
            for _, word in ipairs(keywords) do

                if name:find(word) then

                    found = true

                    notify(
                        "🎉 ¡SECRET ENCONTRADO!",
                        "Brainrot: " .. obj.Name
                    )

                    print("✅ BRAINROT DETECTADO:", obj.Name)

                    return true
                end
            end
        end
    end

    return false
end

